#include <AsmMacroIoLibV8.h>

    AREA    |.text|,ALIGN=2,CODE,READONLY

    EXPORT  ArmReplaceLiveTranslationEntry
    EXPORT  ArmReplaceLiveTranslationEntryEnd
    EXPORT  ArmReplaceLiveTranslationEntrySize

#define CTRL_M_BIT      (1 << 0)

//VOID
//ArmReplaceLiveTranslationEntry (
//  IN  UINT64  *Entry,
//  IN  UINT64  Value
//  )
ArmReplaceLiveTranslationEntry PROC

  // disable interrupts
  mrs   x2, daif
  msr   daifset, #0xf
  isb

  // clean and invalidate first so that we don't clobber
  // adjacent entries that are dirty in the caches
  dc    civac, x0
  dsb   ish

  EL1_OR_EL2_OR_EL3(x3)
1
  mrs   x8, sctlr_el1               // disable the MMU
  bic   x9, x8, #CTRL_M_BIT
  msr   sctlr_el1, x9
  isb
  str   x1, [x0]                    // write updated entry
  dmb   sy                          // invalidate again to get rid of stale clean cachelines that may
  dc    ivac, x0                    // have been filled speculatively since the last invalidate
  tlbi  vmalle1
  dsb   sy
  msr   sctlr_el1, x8               // re-enable the MMU
  isb
  b     %f4
2
  mrs   x8, sctlr_el2               // disable the MMU
  bic   x9, x8, #CTRL_M_BIT
  msr   sctlr_el2, x9
  isb
  str   x1, [x0]                    // write updated entry
  dmb   sy                          // invalidate again to get rid of stale clean cachelines that may
  dc    ivac, x0                    // have been filled speculatively since the last invalidate
  tlbi  alle2
  dsb   sy
  msr   sctlr_el2, x8               // re-enable the MMU
  isb
  b     %f4
3
  mrs   x8, sctlr_el3               // disable the MMU
  bic   x9, x8, #CTRL_M_BIT
  msr   sctlr_el3, x9
  isb
  str   x1, [x0]                    // write updated entry
  dmb   sy                          // invalidate again to get rid of stale clean cachelines that may
  dc    ivac, x0                    // have been filled speculatively since the last invalidate
  tlbi  alle3
  dsb   sy
  msr   sctlr_el3, x8               // re-enable the MMU
  isb
4   
    msr   daif, x2
    ret
ArmReplaceLiveTranslationEntryEnd
    nop
ArmReplaceLiveTranslationEntry ENDP

ArmReplaceLiveTranslationEntrySize
    dcd ArmReplaceLiveTranslationEntryEnd - ArmReplaceLiveTranslationEntry

    END