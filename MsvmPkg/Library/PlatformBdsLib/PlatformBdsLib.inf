[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = PlatformBdsLib
  FILE_GUID                      = F844172E-9985-44f2-BADE-0DD783462E95
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PlatformBdsLib|DXE_DRIVER

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC
#

[Sources]
  BdsPlatform.c
  PlatformData.c
  PlatformBdsString.uni
  PlatformString.c
  BdsPlatform.h
  PlatformConsole.h
  PlatformConsole.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  IntelFrameworkModulePkg/IntelFrameworkModulePkg.dec
  MsvmPkg/MsvmPkg.dec

[LibraryClasses]
  BaseLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  BaseMemoryLib
  DebugLib
  PcdLib
  GenericBdsLib
  PciLib
  EmclLib
  BootEventLogLib

[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdPlatformBootTimeOut
  gEfiIntelFrameworkModulePkgTokenSpaceGuid.PcdLogoFile
  gMsvmPkgTokenSpaceGuid.PcdPlatformConsoleMode
  gMsvmPkgTokenSpaceGuid.PcdPlatformBootConsoleMode
  gMsvmPkgTokenSpaceGuid.PcdPlatformStringBufferSize
  gMsvmPkgTokenSpaceGuid.PcdPauseAfterBootFailure
  gMsvmPkgTokenSpaceGuid.PcdConsoleMode

[Protocols]
  gEfiDecompressProtocolGuid
  gEfiVmbusProtocolGuid
  gEfiSerialIoProtocolGuid
  gMsvmConsoleProtocolGuid

[Guids]
  gEfiVmbusChannelDevicePathGuid      # CONSUMES
  gEfiEventExitBootServicesGuid       # CONSUMES
  gEfiEndOfDxeEventGroupGuid          # CONSUMES