        mov     edx, [ebp]+TsEdx        ; Restore volatiles
        mov     ecx, [ebp]+TsEcx
                                        ; must restore eax before any
        mov     eax, [ebp].TsEax        ; selectors! (see trap0e handler)

else

        xorps   xmm0, xmm0              ; clean volatile kernel state
        xorps   xmm1, xmm1              ;
        xorps   xmm2, xmm2              ;
        xorps   xmm3, xmm3              ;
        xorps   xmm4, xmm4              ;
        xorps   xmm5, xmm5              ;
        xorps   xmm6, xmm6              ;
        xorps   xmm7, xmm7              ;

endif ;; (?RestoreVolatiles eq 1)

        cmp     word ptr [ebp]+TsSegCs, KGDT_R0_CODE ; check kernel CS
        je      short @f                ; if e, skip segment restore

        ;
        ; Segment registers must be popped in the order they appear in the trap
        ; frame (GS, ES, DS, FS) to be able to handle recursive faults that may
        ; occur.
        ;

        lea     esp, [ebp]+TsSegGs      ; set esp to offset of gs in trap frame
        pop     gs                      ; restore gs

if (?RestoreSegs eq 1)

        pop     es                      ; restore segment registers
        pop     ds

endif

NonFlatPm_Target:
        lea     esp, [ebp]+TsSegFs      ; set esp to offset of fs in trap frame
        pop     fs                      ; restore fs
@@:
        lea     esp, [ebp]+TsEdi        ; set esp to offset of edi in trap frame

        DEBUG_ERASE_TRAP_FRAME          ; erase trap frame on CHK builds

        pop     edi                     ; restore non-volatiles
        pop     esi
        pop     ebx
        pop     ebp
        add     esp, 4                  ; remove error code from trap frame

        ;
        ; Special system call exit handling.
        ;

ifidn <RestoreFlag>, <RestoreNone>

        public  _KiSystemCallExitBranch
        public  _KiSystemCallExit
        public  _KiSystemCallExit2

;
; RestoreNone is only used for return from System Service.
; If returning to Kernel mode, the processor state does not need
; to be altered (CS, CPL stays the same etc), so simply unwind the
; kernel frame and branch to the saved EIP.
;

        test    dword ptr [esp+4], MODE_MASK

;
; If the following branch is taken, we are returning to usermode.
; If this processor supports the SYSEXIT instruction, the branch
; will be adjusted at boot time to use the appropriate code sequence.
;

_KiSystemCallExitBranch:
        jnz     short _KiSystemCallExit ; if nz, usermode exit

        ;
        ; Exit to kernel mode from system call, faster than IRETD,
        ; unwind the frame and branch to return address.
        ;

        pop     edx                 ; get eip
        pop     ecx                 ; remove CS from stack
        popfd                       ; restore eflags
        jmp     edx

if 0

        ; ISSUE: neerajsi-2012/12/28 Evaluate performance of internal syscall

        sti                         ; reenable interrupts
        ret     8                   ; return to @esp and pop CS and EFLAGs

endif


        iretd                       ; return (non-sysexit)

_KiSystemCallExit2:

        test    dword ptr [esp+8], EFLAGS_TF ; check if trap flag is set
        jne     short _KiSystemCallExit ; if ne, use iret exit

        pop     edx                 ; pop EIP
        add     esp, 4              ; Remove CS
        and     dword ptr [esp], NOT EFLAGS_INTERRUPT_MASK ; Disable interrupts in the flags
        popfd                       ; restore flags
        pop     ecx                 ; pop ESP

        sti                         ; enable interrupts prior to exiting

        iSYSEXIT                    ; resume in usermode

_KiSystemCallExit:
        xor     ecx, ecx            ; sanitize ecx
        xor     edx, edx            ; sanitize edx

endif  ;; (<RestoreFlag> is <RestoreNone>)

        iretd                       ; return

if DBG
Db_NotATrapFrame:
        add     [ebp]+TsDbgArgMark, TRAP_FRAME_MARKER ; put back the orig value
Db_NotValidEntry:
        int 3
        jmp     Db_A
endif

;
;   EXIT_HELPER
;
;       if (PreviousMode == UserMode) {
;           DR* regs = TF.Dr* regs
;       }
;
;   Entry-Conditions:
;
;       DebugActive == TRUE
;       (ebp)->TrapFrame
;
;--

align dword
Dr_ExitHelp:

        test    dword ptr [ebp]+TsEFlags,EFLAGS_V86_MASK
        jnz     short x

        test    dword ptr [ebp]+TsSegCs,MODE_MASK
        jz      Dr_ExitHelp_Target

x:      xor     ebx,ebx
        mov     esi,[ebp]+TsDr0
        mov     edi,[ebp]+TsDr1
        mov     dr7,ebx
        mov     dr0,esi
        mov     ebx,[ebp]+TsDr2
        mov     dr1,edi
        mov     dr2,ebx
        mov     esi,[ebp]+TsDr3
        mov     edi,[ebp]+TsDr6
        mov     ebx,[ebp]+TsDr7
        mov     dr3,esi
        mov     dr6,edi
        mov     dr7,ebx

        jmp     Dr_ExitHelp_Target

ifidn <RestoreFlag>, <RestoreNoSegs>

;
;   Restore segs and volatiles for non-flat R3 PM (VDM in PM)
;   (special handling for KiTrap0D).
;

f:      mov     eax, [ebp].TsEax    ; restore eax before any selectors
                                        ; (see trap0e handler)
        lea     esp, [ebp].TsSegGs

        pop     gs
        pop     es
        pop     ds

        pop     edx
        pop     ecx
        jmp     NonFlatPm_Target

endif   ; not ?RestoreSegs


;
;   TsSegCs contains the special value that means the frame was edited
;   in a way that affected esp, AND it's a kernel mode frame.
;   (Special value is null selector except for RPL.)
;
;   Put back the real CS.
;   push eflags, eip onto target stack
;   restore
;   switch to target stack
;   iret
;

b:      movzx   ebx, word ptr [ebp]+TsTempSegCs
        mov     [ebp]+TsSegCs,ebx

;
;   There is no instruction that will load esp with an arbitrary value
;   (i.e. one out of a frame) and do a return, if no privledge transition
;   is occuring.  Therefore, if we are returning to kernel mode, and
;   esp has been edited, we must "emulate" a kind of iretd.
;
;   We do this by logically pushing the eip,cs,eflags onto the new
;   logical stack, loading that stack, and doing an iretd.  This
;   requires that the new logical stack is at least 1 dword higher
;   than the unedited esp would have been.  (i.e.  It is not legal
;   to edit esp to have a new value < the old value.)
;
;   KeContextToKframes enforces this rule.
;

;
;   Compute new logical stack address
;

        mov     ebx,[ebp]+TsTempEsp
        sub     ebx,12
        mov     [ebp]+TsErrCode,ebx

;
;   Copy eip,cs,eflags to new stack.  note we do this high to low
;

        mov     esi,[ebp]+TsEflags
        mov     [ebx+8],esi
        mov     esi,[ebp]+TsSegCs
        mov     [ebx+4],esi
        mov     esi,[ebp]+TsEip
        mov     [ebx],esi

;
;   Do a standard restore sequence.
;
;   Observe that RestoreVolatiles is honored.  Editing a volatile
;   register has no effect when returning from a system call.
;

if  (?RestoreVolatiles eq 1)
        mov     eax,[ebp].TsEax
        mov     edx, [ebp]+TsEdx
        mov     ecx, [ebp]+TsEcx
endif

        lea     esp, [ebp].TsEdi

        DEBUG_ERASE_TRAP_FRAME      ; erase trap frame on CHK builds

        pop     edi                 ; restore non-volatiles
        pop     esi
        pop     ebx
        pop     ebp

;
;   (esp)->TsErrCode, where we saved the new esp
;

        mov     esp, [esp]          ; Do move not push to avoid increment
        iretd

        endm

;++
;
;   EXIT_TASK_SWITCH    ReturnLabel
;
;   Macro Description:
;
;       Load a task switch frame back into the machine.
;
;       Restore:
;           SSE regs
;           SSE control reg
;           Previous task switch segment
;
;       N.B. This macro generates an IRET!  (i.e. It exits!)
;
;   Arguments:
;
;       ReturnLabel - The label to jump to on return
;
;   Entry-conditions:
;
;       (esp)->base of xmm frame
;       (ebp)->Base of trap frame
;
;   Exit-conditions:
;
;       Does not exit, returns.
;
;--

EXIT_TASK_SWITCH macro ReturnLabel

        mov     edi, esp                ; use edi to reduce encoding size
        RESTORE_SSE_STATE edi           ; restore SSE registers
        mov     esp, ebp                ; free xmm frame
        ldmxcsr [ebp].TsMxCsr           ; restore SSE control register
        add     esp, KTRAP_FRAME_LENGTH ; free trap frame
        pop     dword ptr PCR[PcTss]    ; restore PcTss

        mov     ecx, PCR[PcGdt]
        lea     eax, [ecx] + KGDT_TSS
        mov     byte ptr [eax+5], 08bh  ; 32bit, dpl=0, present, TSS32, *busy*

        pushfd                          ; Set Nested Task bit in EFLAGS
        or      [esp], 04000h           ; so iretd will do a task switch
        popfd

        iretd                           ; Return from task switch
        jmp     ReturnLabel             ; in case we task switch again

        endm

;++
;
;   INTERRUPT_EXIT
;
;   Macro Description:
;
;       This macro is executed on return from an interrupt vector service
;       service routine.  Its function is to restore privileged processor
;       state, and continue thread execution. If control is returning to
;       user mode and there is a user APC pending, then APC level interupt
;       will be requested and control is transferred to the user APC delivery
;       routine, if no higher level interrupt pending.
;
;   Arguments:
;
;       DebugCheck - If not blank, then poll debugger
;       NoCount - If blank, then decrement the interrupt nesting level
;       NoEntropy -
;       InterruptObjectInEDI - See explanation for edi below.
;
;       (TOS)       = previous irql
;       (TOS+4)     = irq vector to eoi (>= PRIMARY_VECTOR_BASE)
;       (TOS+8 ...) = machine_state frame
;       (ebp)      -> machine state frame (trap frame)
;       (edi)       = pointer to the KINTERRUPT object corresponding to the
;                     vector (only read if InterruptObjectInEDI is not blank)
;
;--

INTERRUPT_EXIT macro DebugCheck, NoCount, NoEntropy, InterruptObjectInEDI
local   a, b

ifdef __imp_Kei386EoiHelper@0
ifndef __imp_@KiEntropyQueueDpc@4
    EXTRNP  KiEntropyQueueDpc,1,IMPORT,FASTCALL
endif
else
ifndef @KiEntropyQueueDpc@4
    EXTRNP  KiEntropyQueueDpc,1,,FASTCALL
endif
endif

ifdef __imp_Kei386EoiHelper@0
ifndef __imp_@KiBeginThreadAccountingPeriod@16
    EXTRNP  KiBeginThreadAccountingPeriod,4,IMPORT,FASTCALL
endif
else
ifndef @KiBeginThreadAccountingPeriod@16
    EXTRNP  KiBeginThreadAccountingPeriod,4,,FASTCALL
endif
endif

ifnb <InterruptObjectInEDI>

        mov     ebx, edi                        ; save KINTERRUPT object

else

        xor     ebx, ebx

endif

ifnb <DebugCheck>
        POLL_DEBUGGER
endif
if DBG                                          ; save current eip for
a:      mov     esi, offset a                   ; debugging bad trap frames
endif

ifb <NoCount>
ifb <NoEntropy>

        cmp     byte ptr [ebp].TsEntropyQueueDpc, 0 ; check whether entropy delivery is required
        je      short @f            ; if e, do not collect entropy

        mov     ecx, PCR[PcPrcb]    ; get current PRCB address

        FSTCAPCALL KiEntropyQueueDpc

@@:

endif
endif

        cli                             ; disable interrupt

ifb <NoCount>

        mov     ecx, PCR[PcSelfPcr]     ; get current PCR address
        cmp     byte ptr [ecx]+PcNestingLevel, 1 ; check for interrupt time end
        jg      short @f                ; if nz, more interrupts nested
        rdtsc                           ; read time stamp counter
        sub     eax, [ecx]+PcStartCycles ; compute total cycles for period
        sbb     edx, [ecx]+PcStartCycles+4 ;
        mov     edi, [ecx]+PcCycleTime ;
        add     edi, eax               ;
        adc     [ecx]+PcHighCycleTime, edx ; write high part of cycle time
        add     [ecx]+PcCycleTime, eax  ; accumulate cycles
        adc     [ecx]+PcCycleTime+4, edx ;
        add     [ecx]+PcStartCycles, eax ; compute start of next period
        adc     [ecx]+PcStartCycles+4, edx ;
        mov     edi, [ecx]+PcCurrentThread ; load current thread
        test    byte ptr [edi]+ThThreadControlFlags, THREAD_FLAGS_ACCOUNTING_INTERRUPT ; check for accounting
        jz      short @f                ; if z, accounting not enabled
        push    edx                     ; High 32 bits of the cycle count
        push    eax                     ; Low 32 bits of the cycle count
        xor     edx, edx                ; set thread to NULL
        lea     ecx, [ecx].PcPrcbData   ; set current PRCB address
        FSTCAPCALL KiBeginThreadAccountingPeriod ; decrements nesting level
        jmp     b

@@:                                     ;
        dec     byte ptr [ecx]+PcNestingLevel

b:

endif

        push    ebp			; Pointer to trapframe
        push    ebx                     ; KINTERRUPT object argument for call

ifdef __imp_Kei386EoiHelper@0

        CAPCALL _HalEndSystemInterrupt@16
        CAPJMP  <dword ptr [__imp_Kei386EoiHelper@0]>

else

        CAPCALL <dword ptr [__imp__HalEndSystemInterrupt@16]>
        CAPJMP  Kei386EoiHelper@0

endif

endm

;++
;
;   SPURIOUS_INTERRUPT_EXIT
;
;   Macro Description:
;
;       To exit an interrupt without performing the EOI.
;
;   Arguments:
;
;       NoCount - If blank, then decrement the interrupt nesting level.
;
;       (TOS) = machine_state frame
;       (ebp)-> machine state frame (trap frame)
;
;--

SPURIOUS_INTERRUPT_EXIT macro NoCount
local   a, b

ifdef __imp_Kei386EoiHelper@0
ifndef __imp_@KiBeginThreadAccountingPeriod@16
    EXTRNP  KiBeginThreadAccountingPeriod,4,IMPORT,FASTCALL
endif
else
ifndef @KiBeginThreadAccountingPeriod@16
    EXTRNP  KiBeginThreadAccountingPeriod,4,,FASTCALL
endif
endif

if DBG                                          ; save current eip for
a:      mov     esi, offset a                   ; debugging bad trap frames
endif

ifb <NoCount>

        mov     ecx, PCR[PcSelfPcr]     ; get current PCR address
        cmp     byte ptr [ecx]+PcNestingLevel, 1 ; check for interrupt time end
        jg      short @f                ; if nz, more interrupts nested
        rdtsc                           ; read time stamp counter
        sub     eax, [ecx]+PcStartCycles ; compute total cycles for period
        sbb     edx, [ecx]+PcStartCycles+4 ;
        mov     edi, [ecx]+PcCycleTime ;
        add     edi, eax               ;
        adc     [ecx]+PcHighCycleTime, edx ; write high part of cycle time
        add     [ecx]+PcCycleTime, eax  ; accumulate cycles
        adc     [ecx]+PcCycleTime+4, edx ;
        add     [ecx]+PcStartCycles, eax ; compute start of next period
        adc     [ecx]+PcStartCycles+4, edx ;
        mov     edi, [ecx]+PcCurrentThread ; load current thread
        test    byte ptr [edi]+ThThreadControlFlags, THREAD_FLAGS_ACCOUNTING_INTERRUPT ; check for accounting
        jz      short @f                ; if z, accounting not enabled
        push    edx                     ; High 32 bits of the cycle count
        push    eax                     ; Low 32 bits of the cycle count
        xor     edx, edx                ; set thread to NULL
        lea     ecx, [ecx].PcPrcbData   ; set current PRCB address
        FSTCAPCALL KiBeginThreadAccountingPeriod ; decrements nesting level
        jmp     b

@@:                                     ;
        dec     byte ptr [ecx]+PcNestingLevel

b:

endif

ifdef __imp_Kei386EoiHelper@0

        CAPJMP  <dword ptr [__imp_Kei386EoiHelper@0]>

else

        CAPJMP  Kei386EoiHelper@0

endif

endm

;++
;
;   ENTER_TRAPV86
;
;   Macro Description:
;
;       Construct trap frame for v86 mode traps.
;
;--

ENTER_TRAPV86 macro DRENTER,V86ENTER
        sub     esp, TsErrCode
        mov     word ptr [esp].TsErrCode + 2, 0
        mov     [esp].TsEbx, ebx
        mov     [esp].TsEax, eax
        mov     [esp].TsEbp, ebp
        mov     [esp].TsEsi, esi
        mov     [esp].TsEdi, edi
        mov     [esp].TsEcx, ecx
        mov     [esp].TsEdx, edx
        mov     byte ptr [esp].TsFrameType, EXCEPTION_FRAME ; Set the frame type
        mov     ebp, esp            ; set trap frame pointer in ebp

if DBG
        mov     byte ptr [ebp].TsPreviousPreviousMode, -1
endif

        mov     [ebp].TsDbgArgMark, TRAP_FRAME_MARKER
        mov     ebx, KGDT_R0_PCR
        mov     eax, KGDT_R3_DATA OR RPL_MASK
        mov     fs, ebx
        mov     ds, eax
        mov     es, eax

        SWAP_MXCSR                  ; swap mxcsr

        sub     esp, KXMM_FRAME_SIZE ; allocate space for SSE registers
        and     esp, NOT 0fh        ; align stack pointer to 16 bytes
        mov     esi, esp            ; use esi to reduce encoding size
        SAVE_SSE_STATE esi          ; save SSE registers

        mov     eax, PCR[PcExceptionList]
        mov     [ebp]+TsExceptionList, eax
        mov     eax, dr7
        cld
        test    eax, (NOT DR7_RESERVED_MASK)
        mov     [ebp].TsDr7, eax
        jnz     Dr_&DRENTER

Dr_&V86ENTER:
endm


;++
;
;   EXIT_TRAPV86
;
;   Macro Description:
;
;       if UserApc is pending deliver it
;       if User Context is v86 mode
;          Exit from kernel (does not return)
;       else
;          return (expected to execute EXIT_ALL)
;--

EXIT_TRAPV86 macro
        local w, x, y, z

z:      mov     ebx, PCR[PcPrcbData+PbCurrentThread]
        mov     byte ptr [ebx]+ThAlerted, 0
        cmp     byte ptr [ebx]+ThApcState.AsUserApcPending, 0
        jne     w

        ;
        ; Kernel exit to V86 mode
        ;
        ; Restore XMM registers
        ;

        mov     edi, esp                ; use edi to reduce encoding size
        RESTORE_SSE_STATE edi           ; restore SSE registers

        ldmxcsr [ebp].TsMxCsr           ; restore SSE control register
        lea     esp, [ebp].TsEdx
        pop     edx
        pop     ecx
        pop     eax
        test    dword ptr [ebp].TsDr7, (NOT DR7_RESERVED_MASK)
        jnz     x
y:
        lea     esp, [ebp].TsEdi

        DEBUG_ERASE_TRAP_FRAME

        pop     edi
        pop     esi
        pop     ebx
        pop     ebp
        add     esp,4               ; clear error code
        iretd

x:      xor     ebx, ebx
        mov     esi,[ebp]+TsDr0
        mov     edi,[ebp]+TsDr1
        mov     dr7, ebx            ; Turn off debug exceptions while reloading
        mov     ebx,[ebp]+TsDr2
        mov     dr0,esi
        mov     dr1,edi
        mov     dr2,ebx
        mov     esi,[ebp]+TsDr3
        mov     edi,[ebp]+TsDr6
        mov     ebx,[ebp]+TsDr7
        mov     dr3,esi
        mov     dr6,edi
        mov     dr7,ebx
        jmp     short y

w:
        ;
        ; Dispatch user mode APC
        ; The APC routine runs with interrupts on and at APC level
        ;

        RaiseIrql APC_LEVEL
        push    eax                              ; Save OldIrql
        sti

        STDCAPCALL _KiDeliverApc, <1, 0, ebp>    ; ebp - Trap frame
                                                 ; 0 - Null exception frame
                                                 ; 1 - Previous mode

        pop     ecx                              ; (TOS) = OldIrql
        LowerIrql ecx

        cli

        ;
        ; UserApc may have changed to vdm Monitor context (user flat 32)
        ; If it has cannot use the v86 only kernel exit
        ;

        test    dword ptr [ebp]+TsEFlags,EFLAGS_V86_MASK
        jnz     z

        ; Exit to do EXIT_ALL
endm

