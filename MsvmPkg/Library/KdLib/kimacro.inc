;++
;
;   These constants are used by the fpo directives in this file.
;   This directive causes the assembler to output a .debug$f segment
;   in the obj file.  The segment will contain 1 fpo record for each
;   directive present during assembly.
;
;   Although the assembler will accept all valid values, the value of 7
;   in the FPO_REGS field indicates to the debugger that a trap frame is
;   generated by the function.  The value of 7 can be used because the
;   C/C++ compiler puts a maximum value of 3 in the field.
;
FPO_LOCALS      equ     0         ; 32 bits, size of locals in dwords
FPO_PARAMS      equ     0         ; 32 bits, size of parameters in dwords
FPO_PROLOG      equ     0         ; 12 bits, 0-4095, # of bytes in prolog
FPO_REGS        equ     0         ; 3 bits, 0-7, # regs saved in prolog
FPO_USE_EBP     equ     0         ; 1 bit, 0-1, is ebp used?
FPO_TRAPFRAME   equ     1         ; 2 bits, 0=fpo, 1=trap frame, 2=tss
;
;--

;++
;
;   POLL_DEBUGGER
;
;   Macro Description:
;
;       Call the debugger so it can check for control-c.  If it finds
;       it, it will report our iret address as address of break-in.
;
;       N.B. This macro should be used when all the caller's registers
;            have been restored. (Otherwise, the kernel debugger register
;            dump will not have correct state.)  The only exception is
;            fs.  This is because Kd may need to access PCR or PRCB.
;
;       This will not modify non-volatile registers.
;
;   Arguments:
;
;       There MUST be an iret frame on the stack when this macro
;       is invoked.
;
;   Exit:
;
;       Debugger will iret for us, so we don't usually return from
;       this macro, but remember that it generates nothing for non-DEVL
;       kernels.
;--

POLL_DEBUGGER   macro
local   a, b, c_

if  DEVL
        EXTRNP   _DbgBreakPointWithStatus,1
        STDCAPCALL _KdPollBreakIn
        or      al,al
        jz      short c_
        STDCAPCALL _DbgBreakPointWithStatus,<DBG_STATUS_CONTROL_C>
c_:
endif   ; DEVL
endm

;++
;
;   ASSERT_FS
;
;   Try to catch funky condition wherein we get FS=r3 value while
;   running in kernel mode.
;
;--

ASSERT_FS   macro
local   a,b

if DBG
        EXTRNP   _KeBugCheck,1

        push    edx
        mov     dx,fs
        cmp     dx,KGDT_R0_PCR
        jnz     short a

        cmp     dword ptr fs:[0], 0
        jne     short b

a:
        STDCAPCALL _KeBugCheck,<-1>, <NoRet>
align 4
b:
        pop     edx
endif
endm



;++
;
;
;   Copy data from various places into base of TrapFrame, net effect
;   is to allow dbg KB command to trace across trap frame, and to
;   allow user to find arguments to system calls.
;
;   USE ebx and edi.
;--

SET_DEBUG_DATA  macro

ife FPO

;
; This macro is used by ENTER_SYSCALL, ENTER_TRAP and ENTER_INTERRUPT
; and is used at the end of above macros.  It is safe to destroy ebx, edi.
;

        mov     ebx,[ebp]+TsEbp
        mov     edi,[ebp]+TsEip
        mov     [ebp]+TsDbgArgMark, TRAP_FRAME_MARKER
        mov     [ebp]+TsDbgEbp,ebx
        mov     [ebp]+TsDbgEip,edi
endif

endm

;++
;
;   SAVE_SSE_STATE      TargetRegister
;
;   Macro Description:
;
;       This macro generates code to save SSE registers (all of which are
;       volatile) to the specified target location.
;
;   Arguments:
;
;       TargetRegister - Supplies a register pointing to a 16-byte aligned
;           XMM save frame.
;
;   Registers Used:
;
;       None.
;
;--

SAVE_SSE_STATE  macro TargetRegister

        movaps  [TargetRegister + 0 * 10h], xmm0 ; save SSE registers
        movaps  [TargetRegister + 1 * 10h], xmm1 ;
        movaps  [TargetRegister + 2 * 10h], xmm2 ;
        movaps  [TargetRegister + 3 * 10h], xmm3 ;
        movaps  [TargetRegister + 4 * 10h], xmm4 ;
        movaps  [TargetRegister + 5 * 10h], xmm5 ;
        movaps  [TargetRegister + 6 * 10h], xmm6 ;
        movaps  [TargetRegister + 7 * 10h], xmm7 ;

        endm

;++
;
;   RESTORE_SSE_STATE   SourceRegister
;
;   Macro Description:
;
;       This macro generates code to restore SSE registers (all of which are
;       volatile) from the specified location.
;
;   Arguments:
;
;       SourceRegister - Supplies a register pointing to a 16-byte aligned
;           XMM save frame.
;
;   Registers Used:
;
;       None.
;
;--

RESTORE_SSE_STATE  macro SourceRegister

        movaps  xmm0, [SourceRegister + 0 * 10h]   ; restore SSE registers
        movaps  xmm1, [SourceRegister + 1 * 10h]   ;
        movaps  xmm2, [SourceRegister + 2 * 10h]   ;
        movaps  xmm3, [SourceRegister + 3 * 10h]   ;
        movaps  xmm4, [SourceRegister + 4 * 10h]   ;
        movaps  xmm5, [SourceRegister + 5 * 10h]   ;
        movaps  xmm6, [SourceRegister + 6 * 10h]   ;
        movaps  xmm7, [SourceRegister + 7 * 10h]   ;

        endm

;++
;
;   SWAP_MXCSR
;
;   Macro Description:
;
;       This macro saves the current mxcsr to the trap frame and loads the
;       canonical value.
;
;   Arguments:
;
;       TrapFrame (ebp) - Supplies a pointer to the trap frame.
;
;   Registers Used:
;
;       MxCsr.
;--

SWAP_MXCSR macro

if DBG

        cmp     PCR[PcMxCsr], INITIAL_MXCSR    ; check for canonical control register value
        je      short @f                       ; if e, valid

        int     3

@@:

endif

        stmxcsr [ebp].TsMxCsr       ; save SSE control register
        ldmxcsr PCR[PcMxCsr]        ; load canonical control register value

        endm

;++
;
;   DEBUG_ERASE_TRAP_FRAME
;
;   Macro Description:
;
;       On CHK builds, this macro fills the saved trap state with zeroes as the
;       frame is being unwound. This exposes issues where stale trap data is
;       incorrectly used on a later trap.
;
;   Arguments:
;
;       TrapFrame (ebp) - Supplies a pointer to the old trap frame base.
;
;       NonvolatileRegisters (esp) - Supplies a pointer to the nonvolatile
;           registers that are yet to be restored.
;
;   Registers Used:
;
;       EDI
;
;--

DEBUG_ERASE_TRAP_FRAME macro

if DBG

        mov     edi, esp                ; copy stack pointer value
        sub     edi, ebp                ; determine trap frame offset
        cmp     edi, TsEdi              ; check offset
        je      @f                      ; if e, trap frame is correct
        int     3
@@:

        mov     edi, ebp                ; copy original trap frame address

@@:
        mov     dword ptr ss:[edi], 0AAAAAAAAh ; fill trap data
        add     edi, 4                  ; advance pointer
        cmp     edi, esp                ; check for termination
        jne     @b                      ; if ne, more work to do

endif

        endm


;++
;
;   ENTER_DR_ASSIST     EnterLabel, ExitLabel, NoAbiosAssist, NoV86Assist
;
;   Macro Description:
;
;       Jumped to by ENTER_ macros to deal with DR register work and v86 work.
;       The main purpose of this macro is to generate code to handle less
;       common situations when a trap occurs (debug registers active or
;       virtual 8086 mode enabled).
;
;       If (previousmode == usermode) {
;           save DR* in trapframe
;           load DR* from Prcb
;       }
;
;   Arguments:
;       EnterLabel - label to emit
;       ExitLabel - label to branch to when done
;
;   Entry-conditions:
;     Dr work:
;       DebugActive == TRUE
;       (esp)->base of trap frame
;       (ebp)->base of trap frame
;
;     v86 work:
;
;   Exit-conditions:
;     Dr work:
;       Interrupts match input state (this routine doesn't change IEF)
;       (esp)->base of trap frame
;       (ebp)->base of trap frame
;       Preserves entry eax, edx
;     v86 work:
;
;--

ENTER_DR_ASSIST macro   EnterLabel, ExitLabel, NoV86Assist, V86R
        local   a,b

        public  Dr_&EnterLabel
align 4
Dr_&EnterLabel:

;
; Test if we came from user-mode.  If not, do nothing.
;
        test    dword ptr [ebp]+TsEFlags,EFLAGS_V86_MASK
        jnz     short a

.errnz (MODE_MASK AND 0FFFFFF00h)
        test    byte ptr [ebp]+TsSegCs,MODE_MASK
        jz      Dr_&ExitLabel          ; called from kmode, go continue


;
; Save user-mode Dr* regs in TrapFrame
;
; We are safe to destroy ebx, ecx, edi because in ENTER_INTERRUPT and
; ENTER_TRAP these registers are saved already.  In ENTER_SYSCALL
; ebx, edi is saved and ecx is saved as needed.
;

a:      mov     ebx,dr0
        mov     ecx,dr1
        mov     edi,dr2
        mov     [ebp]+TsDr0,ebx
        mov     [ebp]+TsDr1,ecx
        mov     [ebp]+TsDr2,edi
        mov     ebx,dr3
        mov     ecx,dr6
        mov     edi,dr7
        mov     [ebp]+TsDr3,ebx
        mov     [ebp]+TsDr6,ecx
        xor     ebx,ebx
        mov     [ebp]+TsDr7,edi

;
; Make Dr7 safe before loading junk from save area
;
        mov     dr7,ebx

;
; Load KernelDr* into processor
;

        mov     edi,dword ptr fs:[PcPrcb]
        mov     ebx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr0
        mov     ecx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr1
        mov     dr0,ebx
        mov     dr1,ecx
        mov     ebx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr2
        mov     ecx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr3
        mov     dr2,ebx
        mov     dr3,ecx
        mov     ebx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr6
        mov     ecx,[edi].PbProcessorState.PsSpecialRegisters.SrKernelDr7
        mov     dr6,ebx
        mov     dr7,ecx

ifnb <V86R>
        test    dword ptr [ebp]+TsEFlags,EFLAGS_V86_MASK
        jz      short b
        jmp     Dr_&V86R
endif
b:
        jmp     Dr_&ExitLabel


ifb <NoV86Assist>

        public  V86_&EnterLabel
align 4
V86_&EnterLabel:

;
; Move the V86 segment registers to the correct place in the frame.
;
; N.B. The kernel data segment registers (other than SS) have not yet been set,
;      so only ebp and esp references are valid without segment override prefixes.
;

        mov     eax,dword ptr [ebp].TsV86Fs
        mov     ebx,dword ptr [ebp].TsV86Gs
        mov     ecx,dword ptr [ebp].TsV86Es
        mov     edx,dword ptr [ebp].TsV86Ds
        mov     [ebp].TsSegFs,ax
        mov     [ebp].TsSegGs,bx
        mov     [ebp].TsSegEs,cx
        mov     [ebp].TsSegDs,dx
        jmp     V86_&ExitLabel

endif   ; NoV86Assist

        endm

;++
;
;   ENTER_SYSCALL       AssistLabel, TagetLabel, NoFSLoad, SaveEcx
;
;   Macro Description:
;
;       Build the frame and set registers needed by a system call.
;
;       Save:
;           Errorpad,
;           Non-volatile regs,
;           FS, GS,
;           ExceptionList,
;           PreviousMode
;
;       Don't Save:
;           Volatile regs
;           Seg regs
;           Floating point state
;
;       Set:
;           FS,
;           ExceptionList,
;           PreviousMode,
;           Direction
;
;   Arguments:
;       AssistLabel - label ENTER_ASSIST macro is at
;       TargetLabel - label to emit for ENTER_ASSIST to jump to
;       NoFSLoad    - Don't set FS(it is already set to KGDT_R0_PCR at entry).
;       SaveEcx     - Save ecx off in the trap frame.
;
;   Exit-conditions:
;       Interrupts match input state (this routine doesn't change IEF)
;       (esp)->base of trap frame
;       (ebp)->base of trap frame
;       Preserves entry eax, edx
;
;   Note:
;       The DS: reference to PreviousMode is *required* for correct
;       functioning of lazy selector loads.  If you remove this use
;       of DS:, put a DS: override on something.
;
;--

ENTER_SYSCALL macro     AssistLabel, TargetLabel, RejectVdmLabel, SaveEcx


.FPO ( FPO_LOCALS, FPO_PARAMS, FPO_PROLOG, FPO_REGS, FPO_USE_EBP, FPO_TRAPFRAME )

ifdef KERNELONLY

;
; Construct trap frame.
;
; N.B. The initial part of the trap frame is constructed by pushing values
;      on the stack. If the format of the trap frame is changed, then the
;      following code must alos be changed.
;

        push    0                       ; put pad dword for error on stack

        .errnz (TsErrCode - TsEbp - 4)
        push    ebp                     ; save the non-volatile registers
        push    ebx                     ;
        push    esi                     ;
        push    edi                     ;
        .errnz (TsEbp - TsSegFs - 4 * 4)
        push    fs                      ; save and set FS to PCR.
        mov     ebx, KGDT_R0_PCR        ; set PCR segment selector
        mov     fs, ebx                 ;
        mov     ebx, KGDT_R3_DATA OR RPL_MASK
        mov     ds, ebx
        mov     es, ebx
        mov     esi,PCR[PcPrcbData+PbCurrentThread] ; get current thread address
;
; Save the old exception list in trap frame and initialize a new empty
; exception list.
;

        .errnz  (TsSegFs - TsExceptionList - 4)
        push    PCR[PcExceptionList]    ; save old exception list
        mov     ebx, _KiI386ExceptionChainTerminator ; load new terminator
        mov     PCR[PcExceptionList], ebx ; set new empty list

;
; Save the old previous mode in trap frame, allocate remainder of trap frame,
; and set the new previous mode.
;

        sub     esp,TsExceptionList     ; allocate remainder of trap frame
        mov     ebp, esp                ; set trap frame address
        movzx   ebx, byte ptr [esi].ThPreviousMode; get old previous mode
        mov     [ebp].TsPreviousPreviousMode, bl    ; save in trap frame

        mov     ebx,[ebp+TsSegCS]       ; compute new previous mode

        .errnz (MODE_MASK - 1)
        and     ebx, MODE_MASK          ;
        mov     [esi]+ThPreviousMode, bl ; set new previous mode

        SWAP_MXCSR                  ; swap mxcsr

        mov     ebx, gs
        mov     [ebp].TsSegGs, ebx ; save GS
        xor     ebx, ebx
        mov     gs, ebx            ; set GS

;
; Save the old trap frame address and set the new trap frame address.
;

        mov     ebx,[esi].ThTrapFrame   ; save current trap frame address
        mov     [ebp].TsEdx,ebx         ;       in the EDX field
ifnb <SaveEcx>
        mov     [ebp].TsEcx,ecx         ; Save ecx if requested
endif
        mov     byte ptr [ebp].TsFrameType, SYSCALL_FRAME ; Set the frame type
        and     dword ptr [ebp].TsDr7, 0
        test    byte ptr [esi].ThDebugActive, DEBUG_ACTIVE_MASK ; See if we need to save debug registers

        mov     [esi].ThTrapFrame,ebp   ; set new trap frame address
        cld                             ; make sure direction is forward

        jnz     Dr_&AssistLabel         ; if nz, debugging is active on thread

Dr_&TargetLabel:                        ;

        SET_DEBUG_DATA                  ; Note this destroys edi
        sti                             ; enable interrupts

else
        %out    ENTER_SYSCALL outside of kernel
        .err
endif
        endm

;++
;
;   ENTER_INTERRUPT
;
;   Macro Description:
;
;       Build the frame and set registers needed by an interrupt.
;
;       Save:
;           Errorpad,
;           Non-volatile regs,
;           FS,
;           ExceptionList,
;           PreviousMode
;           Volatile regs
;           Seg regs from V86 mode
;           DS, ES, GS
;
;       Don't Save:
;           Floating point state
;
;       Set:
;           FS,
;           ExceptionList,
;           Direction,
;           DS, ES
;
;       Don't Set:
;           PreviousMode
;
;   Arguments:
;
;       AssistLabel - label ENTER_ASSIST macro is at
;       TargetLabel - label to emit for ENTER_ASSIST to jump to
;       PassParm - If blank, then push esp on the stack
;       NoCount - If blank, then increment the interrupt nesting level
;
;   Exit-conditions:
;       Interrupts match input state (this routine doesn't change IEF)
;       (esp)->base of xmm frame
;       (ebp)->base of trap frame
;       Preserves entry eax, ecx, edx
;
;--

ENTER_INTERRUPT macro AssistLabel, TargetLabel, PassParm, NoCount, NoEntropy
        local b

.FPO ( FPO_LOCALS+2, FPO_PARAMS, FPO_PROLOG, FPO_REGS, FPO_USE_EBP, FPO_TRAPFRAME )

ifdef __imp_Kei386EoiHelper@0
ifndef __imp_@KiEndThreadAccountingPeriod@16
    EXTRNP  KiEndThreadAccountingPeriod,4,IMPORT,FASTCALL
endif
else
ifndef @KiEndThreadAccountingPeriod@16
    EXTRNP  KiEndThreadAccountingPeriod,4,,FASTCALL
endif
endif

;
; N.B. Until the segment registers are reloaded, all memory references must be
;      relative to either esp or ebp, which implicitly use the SS selector.
;

        .errnz (TsEip - TsErrCode - 4)
ifb <PassParm>
        push    esp                 ; Use Error code field to save 16bit esp
endif

        .errnz (TsErrCode - TsEbp - 4)
        push    ebp                 ; Save the non-volatile registers
        push    ebx                 ;
        push    esi                 ;
        push    edi                 ;

        sub     esp, TsEdi          ; allocate the rest of the trap frame
        mov     ebp, esp            ;

        mov     [ebp]+TsEax, eax    ; Save volatile registers
        mov     [ebp]+TsEcx, ecx    ;
        mov     [ebp]+TsEdx, edx    ;
        mov     byte ptr [ebp].TsFrameType, INTERRUPT_FRAME ; Set the frame type

if DBG
        mov     byte ptr [ebp]+TsPreviousPreviousMode, -1 ; ThPreviousMode not pushed on interrupt
endif

        test    dword ptr [ebp].TsEFlags,EFLAGS_V86_MASK

        jnz     V86_&AssistLabel

        cmp     word ptr [ebp]+TsSegCs, KGDT_R0_CODE
        jz      short @f

        mov     [ebp]+TsSegFs, fs  ; Save and set FS to PCR.
        mov     [ebp]+TsSegDs, ds
        mov     [ebp]+TsSegEs, es
        mov     [ebp]+TsSegGs, gs

V86_&TargetLabel:
        mov     ebx,KGDT_R0_PCR
        mov     eax,KGDT_R3_DATA OR RPL_MASK
        mov     fs, ebx
        mov     ds, eax
        mov     es, eax

;
; After this point it is safe to reference memory using registers other than
; esp or ebp without explicit segment overrides.
;

@@:     sub     esp, KXMM_FRAME_SIZE ; allocate space for SSE registers
        and     esp, NOT 0fh        ; align stack pointer to 16 bytes
        mov     esi, esp            ; use esi to reduce encoding size
        SAVE_SSE_STATE esi          ; save SSE registers
        mov     ebx, fs:[PcExceptionList] ;Save, set ExceptionList
        mov     ecx, _KiI386ExceptionChainTerminator
        mov     fs:[PcExceptionList], ecx
        mov     [ebp]+TsExceptionList, ebx
        SWAP_MXCSR                  ; swap mxcsr

ifnb <PassParm>
        lea     eax, [ebp].TsErrCode
        lea     ecx, [ebp].TsEip    ; Move eax to EIP field
        mov     ebx, ss:[eax]       ; (ebx) = parameter to pass
        mov     ss:[eax], ecx       ; save 16bit esp
endif

        mov     dword ptr [ebp].TsErrCode, 0 ; Indicate no Abios remapping.
        cld

ifb <NoCount>

        mov     byte ptr [ebp].TsEntropyQueueDpc, 0 ; initialize entropy delivery flag
        mov     edi, PCR[PcPrcb]        ; get current PRCB address
        inc     byte ptr [edi]+PbNestingLevel ; increment interrupt nesting level
        cmp     byte ptr [edi]+PbNestingLevel, 1 ; check if thread time
        jne     NoCycle_&TargetLabel    ; if ne, not thread time

        rdtsc                           ; get timestamp

ifb <NoEntropy>

;
; Store the current timestamp counter in the entropy collection buffer,
; mixing it with the timestamps collected by adjacent interrupts.
;
; Each interrupt timestamp is mixed with the adjacent 32 timestamps to
; ensure that every bit of the timestamp contributes to the result.
;

        push    edx                     ; save upper half of timestamp
        mov     esi, [edi]+PbEntropyCount ; get current entropy interrupt count
        mov     edx, esi                ; copy interrupt count
        and     esi, KENTROPY_TIMING_BUFFER_MASK ; compute bit index of the current interrupt
        shr     esi, 5                  ; divide interrupt count by 32 to obtain dword index
        mov     ecx, [edi + 4 * esi]+PbEntropyBuffer ; read existing entropy data
        ror     ecx, 5                  ; rotate existing entropy data
        xor     ecx, eax                ; combine with current timestamp
        mov     [edi + 4 * esi]+PbEntropyBuffer, ecx ; store combined entropy

if KENTROPY_TIMING_ANALYSIS

        mov     esi, [edi]+PbEntropyRawTimestamps ; get raw timestamp buffer pointer
        test    esi, esi                ; check if buffer exists
        jz      @f                      ; if z, analysis not enabled

        mov     ecx, edx                ; copy interrupt count

.errnz (KENTROPY_TIMING_DATA_COUNT AND (KENTROPY_TIMING_DATA_COUNT - 1))

        and     ecx, (KENTROPY_TIMING_DATA_COUNT - 1) ; compute buffer index
        mov     [esi + 4 * ecx], eax    ; store timestamp for analysis

@@:

endif


        add     edx, 1                  ; update entropy collection count
        mov     [edi]+PbEntropyCount, edx ; store new entropy collection count
        and     edx, (KENTROPY_TIMING_INTERRUPTS_PER_BUFFER - 1) ; compute modulus
        jnz     @f                      ; if nz, do not trigger delivery

        mov     byte ptr [ebp].TsEntropyQueueDpc, 1 ; set entropy delivery flag

@@:
        pop     edx                     ; restore upper half of timestamp

endif ; ifb <NoEntropy>


        mov     ecx, [edi]+PbCurrentThread ; load current thread
        sub     eax, [edi]+PbStartCycles ; compute total cycles for period
        sbb     edx, [edi]+PbStartCycles+4 ;
        mov     esi, [ecx]+ThCycleTime  ;
        add     esi, eax                ;
        adc     [ecx]+ThHighCycleTime, edx ; write high part of cycle time
        add     [ecx]+ThCycleTime, eax  ; accumulate cycles
        adc     [ecx]+ThCycleTime+4, edx ;
        add     [edi]+PbStartCycles, eax ; compute start of next period
        adc     [edi]+PbStartCycles+4, edx ;
        test    edx, edx                ; check high cycles
        jnz     short HighRuntime_&TargetLabel ; overflow of runtime
        mov     esi, dword ptr [ecx]+ThCurrentRuntime ; load current runtime
        add     esi, eax                ; accumulate runtime
        jnc     short SaveRuntime_&TargetLabel ;
HighRuntime_&TargetLabel:               ;
        mov     esi, -1                 ; saturate runtime
SaveRuntime_&TargetLabel:               ;
        mov     dword ptr [ecx]+ThCurrentRuntime, esi ; save new runtime
        xor     esi, esi
        test    byte ptr [ecx]+ThThreadControlFlags, THREAD_FLAGS_ACCOUNTING_ANY
        jz      short @f                ;

;
; End accounting for preempted thread.
;

        mov     esi, 1
        push    edx                     ; push 64-bit cycle time
        push    eax                     ;
        mov     edx, ecx                ; load thread address
        mov     ecx, edi                ; load PRCB address

        FSTCAPCALL KiEndThreadAccountingPeriod

NoCycle_&TargetLabel:
        mov     ecx, [edi]+PbCurrentThread           ; reload current thread address
@@:

else

        mov     ecx, PCR[PcPrcbData+PbCurrentThread] ; get current thread address

endif ; ifb <NoCount>

        and     dword ptr [ebp].TsDr7, 0
        test    byte ptr [ecx].ThDebugActive, DEBUG_ACTIVE_MASK ; See if debug registers need saving
ifnb <PassParm>
        push    ebx                 ; push parameter as argument
endif

        jnz     Dr_&AssistLabel

Dr_&TargetLabel:

        SET_DEBUG_DATA

        endm

;++
;
;   ENTER_INTERRUPT_FORCE_STATE
;
;   Macro Description:
;
;       Build the frame and set registers needed by an interrupt.
;
;       This macro is the same as ENTER_INTERRUPT except that it forces the
;       needed state and does not save previous state.
;
;       This macro is currently only used by HalpApicRebootService which does not
;       return;
;
;       Save:
;           Errorpad,
;           Non-volatile regs,
;           ExceptionList,
;           PreviousMode
;           Volatile regs
;           Seg regs from V86 mode
;
;       Don't Save:
;           FS,
;           DS, ES, GS
;           Floating point state
;
;       Set:
;           FS,
;           ExceptionList,
;           Direction,
;           DS, ES
;
;       Don't Set:
;           PreviousMode
;
;   Arguments:
;
;       AssistLabel - label ENTER_ASSIST macro is at
;       TargetLabel - label to emit for ENTER_ASSIST to jump to
;       PassParm - If blank, then push esp on the stack
;       NoCount - If blank, then increment the interrupt nesting level
;
;   Exit-conditions:
;       Interrupts match input state (this routine doesn't change IEF)
;       (esp)->base of xmm frame
;       (ebp)->base of trap frame
;       Preserves entry eax, ecx, edx
;
;--

ENTER_INTERRUPT_FORCE_STATE macro AssistLabel, TargetLabel, PassParm, NoCount
        local b

.FPO ( FPO_LOCALS+2, FPO_PARAMS, FPO_PROLOG, FPO_REGS, FPO_USE_EBP, FPO_TRAPFRAME )

ifdef __imp_Kei386EoiHelper@0
ifndef __imp_@KiEndThreadAccountingPeriod@16
    EXTRNP  KiEndThreadAccountingPeriod,4,IMPORT,FASTCALL
endif
else
ifndef @KiEndThreadAccountingPeriod@16
    EXTRNP  KiEndThreadAccountingPeriod,4,,FASTCALL
endif
endif

;
; N.B. It is unsafe to use memory offsets relative to registers other than EBP
;      or ESP until the segment registers have been set to canonical values.
;

ifb <PassParm>
        push    esp                 ; Use Error code field to save 16bit esp
endif
        push    ebp                 ; Save the non-volatile registers
        push    ebx
        push    esi
        push    edi

        sub     esp, TsEdi
        mov     ebp, esp

        mov     [ebp]+TsEax, eax    ; Save volatile registers
        mov     [ebp]+TsEcx, ecx
        mov     [ebp]+TsEdx, edx
        mov     byte ptr [ebp].TsFrameType, INTERRUPT_FRAME ; Set the frame type

if DBG
        mov     byte ptr [ebp]+TsPreviousPreviousMode, -1 ; ThPreviousMode not pushed on interrupt
endif

        test    dword ptr [ebp].TsEflags,EFLAGS_V86_MASK

        jnz     V86_&AssistLabel

V86_&TargetLabel:
        mov     ebx,KGDT_R0_PCR
        mov     eax,KGDT_R3_DATA OR RPL_MASK
        mov     fs, ebx
        mov     ds, eax
        mov     es, eax

;
; It is now safe to use DS: or ES: relative memory references.
;

@@:     SWAP_MXCSR                  ; swap mxcsr
        sub     esp, KXMM_FRAME_SIZE ; allocate SSE save area
        and     esp, NOT 0fh        ; align stack pointer to 16 bytes
        mov     esi, esp            ; use esi to reduce encoding size
        SAVE_SSE_STATE esi          ; save SSE registers
        mov     ebx, fs:[PcExceptionList] ;Save, set ExceptionList
        mov     ecx, _KiI386ExceptionChainTerminator
        mov     fs:[PcExceptionList], ecx
        mov     [ebp]+TsExceptionList, ebx

ifnb <PassParm>
        lea     eax, [ebp].TsErrCode
        lea     ecx, [ebp].TsEip    ; Move eax to EIP field
        mov     ebx, ss:[eax]       ; (ebx) = parameter to pass
        mov     ss:[eax], ecx       ; save 16bit esp
endif

        cld

ifb <NoCount>

        mov     edi, PCR[PcPrcb]     ; get current PRCB address
        mov     ecx, [edi]+PbCurrentThread ; load current thread
        inc     byte ptr [edi]+PbNestingLevel ; increment interrupt nesting level
        cmp     byte ptr [edi]+PbNestingLevel, 1 ; check if thread time
        jne     short NoCycle_&TargetLabel ; if ne, not thread time
        rdtsc                           ; read time stamp counter
        sub     eax, [edi]+PbStartCycles ; compute total cycles for period
        sbb     edx, [edi]+PbStartCycles+4 ;
        mov     esi, [ecx]+ThCycleTime  ;
        add     esi, eax                ;
        adc     [ecx]+ThHighCycleTime, edx ; write high part of cycle time
        add     [ecx]+ThCycleTime, eax  ; accumulate cycles
        adc     [ecx]+ThCycleTime+4, edx ;
        add     [edi]+PbStartCycles, eax ; compute start of next period
        adc     [edi]+PbStartCycles+4, edx ;
        test    edx, edx                ; check high cycles
        jnz     short HighRuntime_&TargetLabel ; overflow of runtime
        mov     esi, dword ptr [ecx]+ThCurrentRuntime ; load current runtime
        add     esi, eax                ; accumulate runtime
        jnc     short SaveRuntime_&TargetLabel ;
HighRuntime_&TargetLabel:               ;
        mov     esi, -1                 ; saturate runtime
SaveRuntime_&TargetLabel:               ;
        mov     dword ptr [ecx]+ThCurrentRuntime, esi ; save new runtime
        test    byte ptr [ecx]+ThThreadControlFlags, THREAD_FLAGS_ACCOUNTING_ANY
        jz      short @f                ;

;
; End accounting for preempted thread.
;

        push    edx                     ; push 64-bit cycle time
        push    eax                     ;
        mov     edx, ecx                ; load thread address
        mov     ecx, edi                ; load PRCB address

        FSTCAPCALL KiEndThreadAccountingPeriod

        mov     ecx, [edi]+PbCurrentThread ; reload current thread address
@@:
NoCycle_&TargetLabel:

else

        mov     ecx, PCR[PcPrcbData+PbCurrentThread] ; get current thread address

endif ; ifb <NoCount>

        and     dword ptr [ebp].TsDr7, 0
        test    byte ptr [ecx].ThDebugActive, DEBUG_ACTIVE_MASK ; See if debug registers need saving
ifnb <PassParm>
        push    ebx                 ; push parameter as argument
endif

        jnz     Dr_&AssistLabel

Dr_&TargetLabel:

        SET_DEBUG_DATA

        endm

;++
;
;   ENTER_TRAP      AssistLabel, TargetLabel
;
;   Macro Description:
;
;       Build the frame and set registers needed by a trap or exception.
;
;       Save:
;           Non-volatile regs,
;           FS,
;           ExceptionList,
;           PreviousMode,
;           Volatile regs
;           Seg Regs from V86 mode
;           DS, ES, GS
;
;       Don't Save:
;           Floating point state
;
;       Set:
;           FS,
;           Direction,
;           DS, ES
;
;       Don't Set:
;           PreviousMode,
;           ExceptionList
;
;   Arguments:
;       AssistLabel - label ENTER_ASSIST macro is at
;       TargetLabel - label to emit for ENTER_ASSIST to jump to
;
;   Exit-conditions:
;       Interrupts match input state (this routine doesn't change IEF)
;       (esp)->base of xmm frame
;       (ebp)->base of trap frame
;       Preserves entry eax
;
;--

ENTER_TRAP macro    AssistLabel, TargetLabel
        local b

.FPO ( FPO_LOCALS, FPO_PARAMS, FPO_PROLOG, FPO_REGS, FPO_USE_EBP, FPO_TRAPFRAME )

;
;   Fill in parts of frame we care about
;

        mov     word ptr [esp+2], 0 ; Clear upper word of ErrorCode

        .errnz (TsErrCode - TsEbp - 4)
        push    ebp                 ; Save the non-volatile registers
        push    ebx
        push    esi
        push    edi

        .errnz (TsEbp - TsSegFs - 4 * 4)
        push    fs                  ; Save and set FS to PCR.
        mov     ebx,KGDT_R0_PCR     ; get R0 PCR constant
        mov     fs, ebx             ; set R0 PCR selector
        .errnz (TsSegFs - TsExceptionList - 4)
        push    fs:[PcExceptionList] ; save exception list

        .errnz (TsExceptionList - TsMxCsr - 4)
        .errnz (TsMxCsr - TsPreviousPreviousMode - 4)

if DBG

        sub     esp, 4              ; allocate space for MxCsr
        push    -1                  ; Don't need to save ThPreviousMode from trap

else

        sub     esp, 8              ; pad dword

endif

        .errnz (TsPreviousPreviousMode - TsEax - 4)

        push    eax                 ; Save the volatile registers
        push    ecx
        push    edx

        .errnz (TsEax - TsSegDs - 4 * 3)
        push    ds                  ; Save segments
        push    es
        push    gs

;
;   Skip allocate rest of trap frame and Set up DS/ES, they may be trash
;

        mov     eax,KGDT_R3_DATA OR RPL_MASK
        sub     esp,TsSegGs
        mov     ds, eax
        mov     es, eax
        mov     ebp, esp
        mov     byte ptr [ebp].TsFrameType, EXCEPTION_FRAME ; Set the frame type
        SWAP_MXCSR                  ; swap mxcsr

        sub     esp, KXMM_FRAME_SIZE ; allocate space for SSE registers
        and     esp, NOT 0fh        ; align stack pointer to 16 bytes
        mov     esi, esp            ; use esi to reduce encoding size
        SAVE_SSE_STATE esi          ; save SSE registers

        test    dword ptr [ebp].TsEflags, EFLAGS_V86_MASK
        jnz     V86_&AssistLabel

V86_&TargetLabel:

ifdef PcPrcbData
        mov     ecx,PCR[PcPrcbData+PbCurrentThread] ; get current thread address
else
        mov     ecx,PCR[PcPrcb]
        mov     ecx,[ecx].PbCurrentThread ; get current thread address
endif
        cld

        and     dword ptr [ebp].TsDr7, 0
        test    byte ptr [ecx].ThDebugActive, DEBUG_ACTIVE_MASK ; See if debug registers need saving

        jnz     Dr_&AssistLabel

Dr_&TargetLabel:

        SET_DEBUG_DATA


        endm

;++
;
;   ENTER_TASK_SWITCH      KgdtTssOffset BuildFrame
;
;   Macro Description:
;
;       Set registers needed by a task switch and optionally build the frame.
;
;       Save:
;           Previous task switch segment
;           Trap frame for data in previous task switch segment
;
;       Don't Save:
;           Floating point state
;
;       Don't Set:
;           FS,
;           Direction,
;           DS, ES
;           PreviousMode,
;           ExceptionList
;
;   Arguments:
;       KgdtTssOffset - offset of task switch segment
;       BuildFrame - optional argument to build frame
;
;   Exit-conditions:
;       Interrupts disabled
;       TS flag in cr0 cleared
;       Nested task bit in EFLAGS cleared
;       Busy bit in TSS selector cleared
;       (eax)->previous TSS
;       (esp)->base of xmm frame
;       (ebp)->base of trap frame
;
;--

ENTER_TASK_SWITCH macro    KgdtTssOffset, BuildFrame

ifnb <BuildFrame>

.FPO ( 1, 0, 0, 0, 0, 2 )

else

.FPO ( 0, 0, 0, 0, 0, 2 )

endif

        cli                         ; disable interrupt

;
; The CR0 TS bit must be cleared to avoid nested faults when accessing SSE
; state.
;

        clts                        ; clear TS flag in cr0

;
; Set CR3, the I/O map base address, and LDT segment selector
; in the old TSS since they are not set on context
; switches. These values will be needed to return to the
; interrupted task.
;

        mov     eax, PCR[PcTss]                      ; get old TSS address
        mov     ecx, PCR[PcPrcbData+PbCurrentThread] ; get thread address
        mov     edi, [ecx].ThApcState.AsProcess      ; get process address
        mov     ecx, [edi]+PrDirectoryTableBase      ; get directory base
        mov     [eax]+TssCR3, ecx                    ; set previous cr3

        mov     cx, [edi]+PrIopmOffset               ; get IOPM offset
        mov     [eax]+TssIoMapBase, cx               ; set IOPM offset

        mov     ecx, [edi]+PrLdtDescriptor           ; get LDT descriptor
        test    ecx, ecx                             ; does task use LDT?
        jz      @f
        mov     cx, KGDT_LDT

@@:     mov     [eax]+TssLDT, cx                     ; set LDT into old TSS

;
; Update the TSS pointer in the PCR to point to the new TSS.
; (which is what we're running on, or else we wouldn't be here)
;

        mov     edi, PCR[PcGdt]
        mov     ch, [edi+KgdtTssOffset+KgdtBaseHi]
        mov     cl, [edi+KgdtTssOffset+KgdtBaseMid]
        shl     ecx, 16
        mov     cx, [edi+KgdtTssOffset+KgdtBaseLow]
        mov     PCR[PcTss], ecx

;
; Clear Nested Task bit in EFLAGS
;

        pushfd
        and     [esp], not 04000h
        popfd

;
; Clear the busy bit in the TSS selector
;

        lea     ecx, [edi] + KgdtTssOffset
        mov     byte ptr [ecx+5], 089h  ; 32bit, dpl=0, present, TSS32, not busy

;
; Build frame from the data in the previous TSS.
;

ifnb <BuildFrame>

        push    eax                     ; save the previous TSS
        .errnz (KTRAP_FRAME_LENGTH - TsV86ES - 4 * 4)
        push    0                       ; build trap frame, starting with
        push    0                       ; faked V86Gs thru V86Es
        push    0
        push    0
        push    [eax].TssSs             ; copy fields from TSS to
        push    [eax].TssEsp            ; trap frame.
        push    [eax].TssEflags
        push    [eax].TssCs
        push    [eax].TssEip
        .errnz (TsV86ES - TsErrCode - 6 * 4)
        push    0                       ; error code
        push    [eax].TssEbp            ; save non-volatile registers
        push    [eax].TssEbx            ;
        push    [eax].TssEsi            ;
        push    [eax].TssEdi            ;
        .errnz (TsErrCode - TsSegFs - 5 * 4)
        push    [eax].TssFs             ; save FS segment
        .errnz (TsSegFs - TsExceptionList - 4)
        push    PCR[PcExceptionList]    ; and previous exception list
        .errnz (TsExceptionList - TsMxCsr - 4)
        sub     esp, 4                  ; allocate space for MxCsr
        .errnz (TsMxCsr - TsPreviousPreviousMode - 4)
        push    00ffh                   ; previous mode
        .errnz (TsPreviousPreviousMode - TsEax - 4)
        push    [eax].TssEax            ; save volatile registers
        push    [eax].TssEcx            ;
        push    [eax].TssEdx            ;
        .errnz (TsEax - TsSegDs - 4 * 3)
        push    [eax].TssDs
        push    [eax].TssEs
        push    [eax].TssGs
        .errnz (TsSegDs - TsDr7 - 4 * 3)
        push    0                       ; Push zeroed debug registers
        push    0                       ;
        push    0                       ;
        push    0                       ;
        push    0                       ;
        .errnz (TsDr7 - TsDr0 - 4 * 5)
        push    0
        .errnz (TsDr0 - TsTempEsp - 4)
        push    0                       ; temp ESP
        push    0                       ; temp CS, Logging and FrameType
        .errnz (TsTempEsp - TsDbgArgMark - 4 * 2)
        push    TRAP_FRAME_MARKER       ; push DbgArgMark
        .errnz (TsDbgArgMark - TsDbgEip - 4)
        push    [eax].TssEip
        push    [eax].TssEbp
        .errnz (TsDbgEbp)
        mov     ebp, esp                ; ebp -> TrapFrame
        SWAP_MXCSR                      ; swap mxcsr

        sub     esp, KXMM_FRAME_SIZE    ; allocate space for SSE registers
        and     esp, NOT 0fh            ; align stack pointer to 16 bytes
        mov     esi, esp                ; use esi to reduce encoding size
        SAVE_SSE_STATE esi              ; save SSE registers

        .FPO ( FPO_LOCALS, FPO_PARAMS, FPO_PROLOG, FPO_REGS, FPO_USE_EBP, FPO_TRAPFRAME )

endif

        endm

;++
;
;   RESTORE_PREVIOUS_MODE TrapReg, ThreadReg
;
;   Macro Description:
;
;       This macro generates code to restore the previous mode from the trap
;       frame into the thread and on CHK builds ensure that the value was
;       properly saved.
;
;   Arguments:
;
;       TrapReg - Supplies a register containing a pointer to the current trap
;           frame.
;
;       ThreadReg - Supplies an optional register containing a pointer to the
;           current thread. If Blank, no restoration is performed, but a CHK
;           build check is performed.
;
;   Exit conditions:
;
;       Uses ecx, preserves other registers.
;
;--

RESTORE_PREVIOUS_MODE macro TrapReg, ThreadReg

ifb <ThreadReg>

if DBG

        movzx   ecx, byte ptr [TrapReg].TsPreviousPreviousMode ; load previous previous mode
        cmp     cl, -1                  ; check sentinel value
        je      @f                      ; if e, skip break
        int     3

@@:

endif

else ;; ThreadReg not blank.

        movzx   ecx, byte ptr [TrapReg].TsPreviousPreviousMode ; load previous previous mode

if DBG

        cmp     cl, 1                   ; check previous mode validity
        jbe     @f                      ; if be, valid previous mode
        int     3

@@:     mov     byte ptr [TrapReg].TsPreviousPreviousMode, -1 ; write sentinel value

endif

        mov     byte ptr [ThreadReg].ThPreviousMode, cl ; restore previous mode

endif ;; blank ThreadReg

        endm

;++
;
;   EXIT_ALL    RestoreFlag, NoPreviousMode
;
;   Macro Description:
;
;       Load a syscall frame back into the machine.
;
;       Restore:
;           Volatile regs, IF RestoreFlag is not RestoreNone
;           NoPreviousMode,
;           ExceptionList,
;           FS,
;           Non-volatile regs
;
