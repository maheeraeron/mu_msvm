;       then TsSegCs will have a special value.  Test for that value
;       and execute special code for that case.
;
;       N.B. This macro generates an IRET!  (i.e. It exits!)
;
;   Arguments:
;
;       RestoreFlag - There are four possible values
;
;           <RestoreAll> - Restore volatiles, segments, and SSE
;
;           <RestoreNoSSE> - Restore volatiles and segments
;
;           <RestoreNoSegs> - Restore volatiles and SSE
;
;           <RestoreNone> - Do not restore volatiles or segments or SSE
;
;       NoPreviousMode - if nb pop ThPreviousMode
;
;   Entry-conditions:
;
;       (esp)->base of XMM frame (if it exists)
;       (ebp)->Base of trap frame
;
;   Exit-conditions:
;
;       Does not exit, returns.
;       Preserves eax, ecx, edx, IFF NoRestoreVolatiles is set
;
;--

EXIT_ALL macro  RestoreFlag, NoPreviousMode
local   a, b, f, x
local   Dr_ExitHelp, Dr_ExitHelp_Target
local   Db_NotATrapFrame, Db_A, Db_NotValidEntry, NonFlatPm_Target

?RestoreVolatiles = 0
?RestoreSSE = 0
?RestoreSegs = 0

;
; Restore everything (e.g. trap or exception exit)
;

ifidn <RestoreFlag>, <RestoreAll>

?RestoreVolatiles = 1
?RestoreSSE = 1
?RestoreSegs = 1

;
; Restore everything except for SSE registers (e.g. partial trap frame restore)
;

elseifidn <RestoreFlag>, <RestoreNoSSE>

?RestoreVolatiles = 1
?RestoreSegs = 1

;
; Restore everything except segments (e.g. partial trap frame restore)
;

elseifidn <RestoreFlag>, <RestoreNoSegs>

?RestoreVolatiles = 1
?RestoreSSE = 1

;
; Restore no state (e.g. system call)
;

elseifdif <RestoreFlag>, <RestoreNone>

.ERR Invalid <RestoreFlag> value

endif

;
; Sanity check some values and setup globals for macro
;

ifb <NoPreviousMode>
ifndef KERNELONLY
        %out    EXIT_ALL can not restore previousmode outside kernel
        .err
endif
endif

; All callers are responsible for getting here with interrupts disabled.

if DBG
        pushfd                          ; push eflags
        pop     edx                     ; load eflags in edx

        test    edx, EFLAGS_INTERRUPT_MASK ; check interrupt flag
        jnz     Db_NotValidEntry        ; if nz, interrups enabled

if (?RestoreSSE eq 0)

        cmp     esp, ebp                ; make sure esp = ebp
        jne     Db_NotValidEntry

else

        mov     eax, ebp                ; copy ebp value
        sub     eax, KXMM_FRAME_SIZE    ; subtract size of SSE frame
        and     eax, NOT 0fh            ; align to 16 bytes
        cmp     esp, eax                ; check if esp is correct
        jne     Db_NotValidEntry        ; esp is invalid

endif

;
; Make sure BADB0D00 sig is present.  If not this isn't a trap frame!
;

Db_A:   sub     [ebp]+TsDbgArgMark, TRAP_FRAME_MARKER
        jne     Db_NotATrapFrame

endif ;; DBG

        ASSERT_FS

        mov     edx, [ebp]+TsExceptionList ; get saved exception list

if DBG

        test    edx, edx                ; check for non-NULL
        jnz     short @f                ; if nz, skip breakpoint

        int     3
@@:

endif

        ldmxcsr [ebp]+TsMxCsr           ; restore SSE control register
        mov     PCR[PcExceptionList], edx ; restore exception list

ifb <NoPreviousMode>

        mov     esi, PCR[PcPrcbData+PbCurrentThread] ; get current thread
        RESTORE_PREVIOUS_MODE ebp, esi

else ;; NoPreviousMode is set

        RESTORE_PREVIOUS_MODE ebp

endif ;; blank <NoPreviousMode>

        test    dword ptr [ebp].TsDr7, (NOT DR7_RESERVED_MASK) ; check debug active
        jnz     Dr_ExitHelp             ; if nz, restore debug registers

Dr_ExitHelp_Target:

        test    dword ptr [ebp].TsEflags, EFLAGS_V86_MASK ; check V86 mode active
        jnz     V86ExitHelp             ; if ne, restore V86 mode

if (?RestoreSSE eq 1)

        mov     edi, esp                ; use edi to reduce encoding size
        RESTORE_SSE_STATE edi           ; restore SSE registers

endif

        test    word ptr [ebp]+TsSegCs, FRAME_EDITED ; check frame edit marker
        jz      b                       ; if z, the frame was edited

        ;
        ; Special handling for KiTrap0D (protected mode Ring 3)
        ;

ifidn <RestoreFlag>, <RestoreNoSegs>

        .errnz MODE_MASK-1

        cmp     word ptr [ebp]+TsSegCs, KGDT_R3_CODE OR RPL_MASK ; check if canonical R3 CS
        bt      word ptr [ebp]+TsSegCs,0    ; set CF if not ring0
        cmc                                 ; complement CF
        ja      f                           ; if CF==0 and ZF==0, use special segment restoration

endif

