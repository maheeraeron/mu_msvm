[Defines]
    INF_VERSION                    = 0x00010005
    BASE_NAME                      = EfiKdLib
    FILE_GUID                      = 2557B660-2A10-4248-B44D-257D2DBDE4D2
    MODULE_TYPE                    = DXE_DRIVER
    VERSION_STRING                 = 1.0
