/*++

Copyright (c) Microsoft Corporation

Module Name:

    Facs.aslc

Abstract:

    Defines the FACS fixed ACPI table. This table is mandatory when
    running with fixed ACPI hardware, as it provides storage for the global
    lock.

    It also has fields for implementing hibernate support, but these are
    unused since Hyper-V VMs do not support any sleep states.

Author:

    Rich Yampell (richyam) 24-Jul-2012

--*/

#include <Base.h>
#include <AcpiTables.h>

EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE FACS =
{
    EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE_SIGNATURE,
    sizeof(EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE),
    0, // HardwareSignature
    0, // FirmwareWakingVector
    0, // GlobalLock
    0, // Flags
    0, // XFirmwareWakingVector
    EFI_ACPI_3_0_FIRMWARE_ACPI_CONTROL_STRUCTURE_VERSION, // Version
};

VOID*
ReferenceAcpiTable()
{
    return (VOID*) &FACS;
}

