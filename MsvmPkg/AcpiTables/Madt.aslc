Copyright (c) Microsoft Corporation

Module Name:

    Madt.aslc

Abstract:

    Defines the Multiple APIC Description Table (MADT)

--*/

#include <Base.h>
#include <AcpiTables.h>

VM_MADT_TABLE MADT =
{
    {
        STANDARD_HEADER(EFI_ACPI_6_2_MULTIPLE_APIC_DESCRIPTION_TABLE_SIGNATURE,
                        sizeof(VM_MADT_TABLE),
                        EFI_ACPI_6_2_MULTIPLE_APIC_DESCRIPTION_TABLE_REVISION)
        FixedPcdGet64(PcdGicInterruptInterfaceBase), // Local Interrupt Controller Address - GICC which is the same for all CPUs
        0, // Flags
    },

    {
        EFI_ACPI_6_2_GICD, // Type
        sizeof(EFI_ACPI_6_2_GIC_DISTRIBUTOR_STRUCTURE), // Length
        0, // Reserved - Must be zero
        0, // GICD Hardware ID
        FixedPcdGet64(PcdGicDistributorBase), // Physical Base Address
        0, // System Vector Base
        0, // GIC Version - Initialized at runtime TODO-cho: This can be static GICv3 when we retire GICv2 systems
        { // 3 bytes Reserved - Must be zero
            0,
            0,
            0
        }
    }

    //
    // The rest is runtime-initialized.
    //
};

VOID*
ReferenceAcpiTable()
{
    return (VOID*) &MADT;
}
