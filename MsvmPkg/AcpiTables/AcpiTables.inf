[Defines]
    INF_VERSION                    = 0x00010005
    BASE_NAME                      = PlatformAcpiTables
    FILE_GUID                      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
    MODULE_TYPE                    = USER_DEFINED
    VERSION_STRING                 = 1.0

[Sources]
    Dsdt.asl
    Fadt.aslc
    Oem0.aslc
    Spcr.aslc

[Sources.AARCH64]
    Dbg2.aslc
    Gtdt.aslc
    Madt.aslc

[Sources.X64]
    Facs.aslc
    Waet.aslc

[Pcd]
    gMsvmPkgTokenSpaceGuid.PcdBiosBaseAddress
    gMsvmPkgTokenSpaceGuid.PcdBatteryBase
    gMsvmPkgTokenSpaceGuid.PcdCom1RegisterBase
    gMsvmPkgTokenSpaceGuid.PcdCom1Vector
    gMsvmPkgTokenSpaceGuid.PcdCom2RegisterBase
    gMsvmPkgTokenSpaceGuid.PcdCom2Vector
    gMsvmPkgTokenSpaceGuid.PcdVmbusVector
    gMsvmPkgTokenSpaceGuid.PcdPmemRegisterBase
    gMsvmPkgTokenSpaceGuid.PcdProcIdleBase
    
[Pcd.AARCH64]
    gArmTokenSpaceGuid.PcdGicInterruptInterfaceBase
    gArmTokenSpaceGuid.PcdGicDistributorBase
    gMsvmPkgTokenSpaceGuid.PcdBatteryEventVector
    gMsvmPkgTokenSpaceGuid.PcdGenCountEventVector
    gMsvmPkgTokenSpaceGuid.PcdPmemEventVector
    gMsvmPkgTokenSpaceGuid.PcdProcIdleEventVector

[Pcd.X64]
    gMsvmPkgTokenSpaceGuid.PcdRtcRegisterBase
    gMsvmPkgTokenSpaceGuid.PcdRtcVector
    gPcAtChipsetPkgTokenSpaceGuid.PcdIoApicBaseAddress
    gUefiCpuPkgTokenSpaceGuid.PcdCpuLocalApicBaseAddress
    
[Packages]
    MdePkg/MdePkg.dec
    MsvmPkg/MsvmPkg.dec
    MdeModulePkg/MdeModulePkg.dec

[Packages.AARCH64]
    ArmPkg/ArmPkg.dec

[Packages.X64]
    PcAtChipsetPkg/PcAtChipsetPkg.dec
    UefiCpuPkg/UefiCpuPkg.dec

