#include <Base.h>
#include <AcpiTables.h>

EFI_ACPI_6_1_GENERIC_TIMER_DESCRIPTION_TABLE GTDT =
{
    STANDARD_HEADER(EFI_ACPI_6_1_GENERIC_TIMER_DESCRIPTION_TABLE_SIGNATURE,
                    sizeof(EFI_ACPI_6_1_GENERIC_TIMER_DESCRIPTION_TABLE),
                    EFI_ACPI_6_1_GENERIC_TIMER_DESCRIPTION_TABLE_REVISION)
    0xFFFFFFFFFFFFFFFF, // CntControlBase Physical Address: doesn't exist so -1
    0, // Reserved
    0, // Secure EL1 timer GSIV: doesn't exist so zero
    0, // Secure EL1 timer Flags: doesn't exist so zero
    0, // Non-Secure EL1 timer GSIV: doesn't exist so zero
    0, // Non-Secure EL1 timer Flags: doesn't exist so zero
    0, // Virtual timer GSIV: doesn't exist so zero
    0, // Virtual Timer Flags: doesn't exist so zero
    0, // Non-Secure EL2 timer GSIV: doesn't exist so zero
    0, // Non-Secure EL2 timer Flags: doesn't exist so zero
    0xFFFFFFFFFFFFFFFF, // CntReadBase Physical address: doesn't exist so -1
    0, // Platform Timer Count 
    0, // Platform Timer Offset
};

VOID*
ReferenceAcpiTable()
{
    return (VOID*) &GTDT;
}
