            {                      // Reserved_2[2]
                0,
                0
            },
            {                      // RegisterRegion (address populated during initalization)
                EFI_ACPI_6_2_SYSTEM_IO,
                32,
                0,
                EFI_ACPI_6_2_DWORD,
