            EFI_ACPI_WDAT_1_0_WATCHDOG_INSTRUCTION_WRITE_VALUE, // InstructionFlags
            {                      // Reserved_2[2]
                0,
                0
            },
            {                      // RegisterRegion (address populated during initalization)
