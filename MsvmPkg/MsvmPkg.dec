  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosBiosLockStringSize|0x0|UINT32|0x6011

  # UEFI_CONFIG_SMBIOS_3_1_PROCESSOR_INFORMATION
  # Defaults are set to Unknown unless otherwise noted
