[PcdsFixedAtBuild]
  gUefiMsvmPkgTokenSpaceGuid.PcdMsvmFvBase|0x0|UINT32|0
  gUefiMsvmPkgTokenSpaceGuid.PcdMsvmFvSize|0x0|UINT32|1

  gUefiMsvmPkgTokenSpaceGuid.PcdExdiSupportVersionAddress|0x80000|UINT64|0x1000

  gUefiMsvmPkgTokenSpaceGuid.PcdSynicTimerSintIndex|0x1|UINT8|0x2000
  gUefiMsvmPkgTokenSpaceGuid.PcdSynicTimerTimerIndex|0x0|UINT8|0x2001
  gUefiMsvmPkgTokenSpaceGuid.PcdSynicTimerVector|0x40|UINT8|0x2002
  gUefiMsvmPkgTokenSpaceGuid.PcdSynicTimerDefaultPeriod|100000|UINT64|0x2003

  gUefiMsvmPkgTokenSpaceGuid.PcdVmbusSintVector|0x41|UINT8|0x3000

  gEfiMdeModulePkgTokenSpaceGuid.PcdAcpiTableStorageFile|{ 0x25, 0x4e, 0x37, 0x7e, 0x01, 0x8e, 0xee, 0x4f, 0x87, 0xf2, 0x39, 0xc, 0x23, 0xc6, 0x6, 0xcd }|VOID*|0x30000016

  # maximum number of event channels.
  gUefiMsvmPkgTokenSpaceGuid.PcdEventLogMaxChannels|8|UINT32|0x4000

  # size in bytes of the Boot event log (must be a power of 2)
  gUefiMsvmPkgTokenSpaceGuid.PcdBootEventLogSize|8192|UINT32|0x4001

  # size in bytes of the Status Code event log (must be a power of 2)
  gUefiMsvmPkgTokenSpaceGuid.PcdStatusCodeEventLogSize|8192|UINT32|0x4002

  # video mode number used by the platform console for diagnostic summary output.
  gUefiMsvmPkgTokenSpaceGuid.PcdPlatformConsoleMode|3|UINT16|0x4003

  # video mode number used by the platform console when booting.
  gUefiMsvmPkgTokenSpaceGuid.PcdPlatformBootConsoleMode|0|UINT16|0x4004

  # size of the platform string print buffer in Unicode (UTF-16) characters
  gUefiMsvmPkgTokenSpaceGuid.PcdPlatformStringBufferSize|256|UINT32|0x4005

  # Base addresses of memory mapped devices in MMIO space.
  # The first three are defined by other package PCDs.
  #   gUefiCpuPkgTokenSpaceGuid.PcdCpuLocalApicBaseAddress is 0xFEE00000
  #   gEfiSecurityPkgTokenSpaceGuid.PcdTpmBaseAddress is 0xFED40000
  #   gPcAtChipsetPkgTokenSpaceGuid.PcdIoApicBaseAddress is 0xFEC00000
  # The rest are MsvmPkg PCDs.
  gUefiMsvmPkgTokenSpaceGuid.PcdBatteryBase|0xFED3F000|UINT32|0x5000
  gUefiMsvmPkgTokenSpaceGuid.PcdPmemBase|0xFED3D000|UINT32|0x5001

# Dynamic PCDs used to pass config data between PEI and DXE
# used in lieu of ConfigLib
[PcdsDynamic]
  # UEFI_CONFIG_STRUCTURE_COUNT
  gUefiMsvmPkgTokenSpaceGuid.PcdConfigBlobSize|0x0|UINT32|0x6000

  # UEFI_CONFIG_BIOS_INFORMATION
  gUefiMsvmPkgTokenSpaceGuid.PcdBiosVDevVersion|0x0|UINT32|0x6001

  # UEFI_CONFIG_SRAT
  gUefiMsvmPkgTokenSpaceGuid.PcdSratPtr|0x0|UINT64|0x6002
  gUefiMsvmPkgTokenSpaceGuid.PcdSratSize|0x0|UINT32|0x6003

  # UEFI_CONFIG_MEMORY_MAP
  gUefiMsvmPkgTokenSpaceGuid.PcdMemoryMapPtr|0x0|UINT64|0x6004
  gUefiMsvmPkgTokenSpaceGuid.PcdMemoryMapSize|0x0|UINT32|0x6005

  # UEFI_CONFIG_ENTROPY
  # Points to the actual entropy array, not the containing config structure
  gUefiMsvmPkgTokenSpaceGuid.PcdEntropyPtr|0x0|UINT64|0x6006

  # UEFI_CONFIG_BIOS_GUID
  # Points to the actual GUID, not the containing config structure
  gUefiMsvmPkgTokenSpaceGuid.PcdBiosGuidPtr|0x0|UINT64|0x6007

  # UEFI_CONFIG_SMBIOS_SYSTEM_SERIAL_NUMBER
  # Points to a null terminated string of the specified size
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosSystemSerialNumberStr|0x0|UINT64|0x6008
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosSystemSerialNumberSize|0x0|UINT32|0x6009

  # UEFI_CONFIG_SMBIOS_BASE_SERIAL_NUMBER
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosBaseSerialNumberStr|0x0|UINT64|0x600A
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosBaseSerialNumberSize|0x0|UINT32|0x600B

  # UEFI_CONFIG_SMBIOS_CHASSIS_SERIAL_NUMBER
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosChassisSerialNumberStr|0x0|UINT64|0x600C
  gUefiMsvmPkgTokenSpaceGuid.PcdSmbiosChassisSerialNumberSize|0x0|UINT32|0x600D

  # UEFI_CONFIG_SMBIOS_CHASSIS_ASSET_TAG
