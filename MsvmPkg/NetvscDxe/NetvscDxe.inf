[LibraryClasses]
  DebugLib
  EmclLib
  IsolationLib
  NetLib
  PcdLib
  PrintLib
  UefiDriverEntryPoint

[Guids]
  gEfiEventExitBootServicesGuid                 # CONSUMES
  gEfiVmbusChannelDevicePathGuid                # CONSUMES
  # MS_HYP_CHANGE - Use gEfiEventBeforeExitBootServicesGuid for SnpDxe to issue shutdown before VmBus disconnect
  gEfiEventBeforeExitBootServicesGuid           ## SOMETIMES_CONSUMES ## Event
  gSyntheticNetworkClassGuid                    # CONSUMES MS_HYP_CHANGE

[Protocols]
