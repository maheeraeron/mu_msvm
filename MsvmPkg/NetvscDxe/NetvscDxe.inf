[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = NetvscDxe
  FILE_GUID                      = d2c1389f-e54f-4b33-a4b3-231b373ca37f
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = InitializeSnpDriver
  UNLOAD_IMAGE                   = NetLibDefaultUnload

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC
#
#  DRIVER_BINDING                =  mSimpleNetworkDriverBinding
#  COMPONENT_NAME                =  gSimpleNetworkComponentName
#  COMPONENT_NAME2               =  gSimpleNetworkComponentName2
#

[Sources]
  Receive.c
  Snp.h
  Nvdata.c
  GetStatus.c
  Start.c
  Snp.c
  Stop.c
  Statistics.c
  Reset.c
  Shutdown.c
  McastIpToMac.c
  Transmit.c
  WaitForPacket.c
  ReceiveFilters.c
  Initialize.c
  ComponentName.c
  StationAddress.c
  NetvscDxe.c
  NetvscDxe.h

[Packages]
  MdeModulePkg/MdeModulePkg.dec
  MdePkg/MdePkg.dec
  MsvmPkg/MsvmPkg.dec
  NetworkPkg/NetworkPkg.dec

[LibraryClasses]
  DebugLib
  EmclLib
  IsolationLib
  NetLib
  PcdLib
  PrintLib
  UefiDriverEntryPoint

[Guids]
  gEfiEventExitBootServicesGuid                 # CONSUMES
  gEfiVmbusChannelDevicePathGuid                # CONSUMES
  # MS_HYP_CHANGE - Use gEfiEventBeforeExitBootServicesGuid for SnpDxe to issue shutdown before VmBus disconnect
  gEfiEventBeforeExitBootServicesGuid               ## SOMETIMES_CONSUMES ## Event

[Protocols]
  gEfiDevicePathProtocolGuid                    # PRODUCES
  gEfiEmclProtocolGuid                          # CONSUMES
  gEfiSimpleNetworkProtocolGuid                 # PRODUCES
  gEfiVmbusProtocolGuid                         # CONSUMES
  gInternalEventServicesProtocolGuid            # CONSUMES

[Pcd]
  gEfiNetworkPkgTokenSpaceGuid.PcdSnpCreateExitBootServicesEvent   ## CONSUMES
  gMsvmPkgTokenSpaceGuid.PcdMediaPresentEnabledByDefault           ## CONSUMES
