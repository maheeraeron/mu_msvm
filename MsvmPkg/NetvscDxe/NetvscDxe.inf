  gEfiDevicePathProtocolGuid                    # PRODUCES
  gEfiEmclProtocolGuid                          # CONSUMES MS_HYP_CHANGE
  gEfiVmbusProtocolGuid                         # CONSUMES MS_HYP_CHANGE
  gInternalEventServicesProtocolGuid            # CONSUMES MS_HYP_CHANGE

[Pcd]
