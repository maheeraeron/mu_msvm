[Defines]
    INF_VERSION                    = 0x00010005
    BASE_NAME                      = EfiHvDxe
    FILE_GUID                      = CA585647-54A9-4879-A8CD-45A769246680
    MODULE_TYPE                    = DXE_DRIVER
    VERSION_STRING                 = 1.0

    ENTRY_POINT                    = EfiHvInitialize

[Packages]
    MdePkg/MdePkg.dec
    MsvmPkg/MsvmPkg.dec

[Packages.X64]
    UefiCpuPkg/UefiCpuPkg.dec

[Packages.AARCH64]
    EmbeddedPkg/EmbeddedPkg.dec

[LibraryClasses]
    UefiBootServicesTableLib
    BaseLib
    DebugLib
    UefiDriverEntryPoint
    MemoryAllocationLib
    HvHypercallLib
    DebugLib
    IsolationLib

[LibraryClasses.X64]
    HostVisibilityLib
    LocalApicLib

[Sources]
    EfiHv.c

[Guids]
    gEfiEventExitBootServicesGuid

[Protocols]
    gEfiHvProtocolGuid      #PRODUCES
    gEfiHvIvmProtocolGuid   #PRODUCES

[Protocols.X64]
    gEfiCpuArchProtocolGuid

[Protocols.AARCH64]
    gHardwareInterruptProtocolGuid

[Depex.X64]
    gEfiCpuArchProtocolGuid

[Depex.AARCH64]
    gHardwareInterruptProtocolGuid

[Pcd]
    gMsvmPkgTokenSpaceGuid.PcdIsolationSharedGpaBoundary
    gMsvmPkgTokenSpaceGuid.PcdIsolationSharedGpaCanonicalizationBitmask
    gMsvmPkgTokenSpaceGuid.PcdSvsmCallingArea
