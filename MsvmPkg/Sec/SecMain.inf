[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = SecMain
  FILE_GUID                      = df1ccef6-f301-4a63-9661-fc6030dcc880
  MODULE_TYPE                    = SEC
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = SecMain

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC AARCH64
#

[Sources]

[Sources.IA32]
  Ia32/SecMain.c
  Ia32/SecEntry.asm | MSFT
  Ia32/SecEntry.asm | INTEL

[Sources.X64]
  X64/SecMain.c
  X64/SecIso.c
  X64/SecEntry.asm  | MSFT
  X64/SecEntry.asm  | INTEL

[Sources.AARCH64]
  AArch64/SecMain.c
  AArch64/SecEntry.masm | MSFT

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsvmPkg/MsvmPkg.dec

[Packages.IA32]
  UefiCpuPkg/UefiCpuPkg.dec

[Packages.X64]
  UefiCpuPkg/UefiCpuPkg.dec

[Packages.AARCH64]
  ArmPkg/ArmPkg.dec

[LibraryClasses]
  BaseLib
  DebugLib
  BaseMemoryLib
  DebugAgentLib

[LibraryClasses.IA32]
  PeCoffExtraActionLib
  PeCoffGetEntryPointLib
  PeCoffLib
  UefiCpuLib

[LibraryClasses.X64]
  PeCoffExtraActionLib
  PeCoffGetEntryPointLib
  PeCoffLib
  UefiCpuLib

[LibraryClasses.AARCH64]
  ArmLib

[Ppis]
  gEfiTemporaryRamSupportPpiGuid                # PPI ALWAYS_PRODUCED

[FixedPcd]
  gMsvmPkgTokenSpaceGuid.PcdFdBaseAddress
  gMsvmPkgTokenSpaceGuid.PcdFdSize
  gMsvmPkgTokenSpaceGuid.PcdFvBaseAddress
  gMsvmPkgTokenSpaceGuid.PcdFvSize

