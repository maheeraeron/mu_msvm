[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CpuDxe
  FILE_GUID                      = 1A1E4886-9517-440e-9FDE-3BE44CEE2136
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0

  ENTRY_POINT                    = InitializeCpu

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  UefiCpuPkg/UefiCpuPkg.dec
  MsvmPkg/MsvmPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CpuExceptionHandlerLib
  CpuLib
  DebugLib
  DxeServicesTableLib
  MemoryAllocationLib
  MemoryProtectionLib
  MpInitLib
  MtrrLib
  ReportStatusCodeLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  LocalApicLib
  UefiCpuLib

[Sources]
  CpuDxe.c
  CpuDxe.h
  CpuGdt.c
  CpuMp.c
  CpuMp.h
  CpuPageTable.h
  CpuPageTable.c

  Ia32/IvtAsm.asm | MSFT
  Ia32/IvtAsm.asm | INTEL
  Ia32/IvtAsm.S   | GCC

[Sources.IA32]
  Ia32/CpuAsm.asm | MSFT
  Ia32/CpuAsm.asm | INTEL
  Ia32/CpuAsm.S   | GCC

  Ia32/PagingAttribute.c

[Sources.X64]
  X64/CpuAsm.asm | MSFT
  X64/CpuAsm.asm | INTEL
  X64/CpuAsm.S   | GCC

  X64/PagingAttribute.c

[Protocols]
  gEfiCpuArchProtocolGuid
  gEfiCpu2ProtocolGuid
  gEfiMpServiceProtocolGuid                     ## PRODUCES

[Guids]
  gIdleLoopEventGuid                            ## CONSUMES ## GUID

[Ppis]
  gEfiSecPlatformInformation2PpiGuid            ## UNDEFINED # HOB
  gEfiSecPlatformInformationPpiGuid             ## UNDEFINED # HOB

[Depex]
  TRUE

[Pcd]
    gMsvmPkgTokenSpaceGuid.PcdIsolationArchitecture
    gMsvmPkgTokenSpaceGuid.PcdIsolationParavisorPresent
    gEfiMdeModulePkgTokenSpaceGuid.PcdPteMemoryEncryptionAddressOrMask    ## CONSUMES
    gEfiMdeModulePkgTokenSpaceGuid.PcdCpuStackGuard                       ## CONSUMES
    gEfiMdeModulePkgTokenSpaceGuid.PcdHeapGuardPropertyMask               ## CONSUMES
    gEfiMdeModulePkgTokenSpaceGuid.PcdNullPointerDetectionPropertyMask    ## CONSUMES
    gUefiCpuPkgTokenSpaceGuid.PcdCpuStackSwitchExceptionList              ## CONSUMES
    gUefiCpuPkgTokenSpaceGuid.PcdCpuKnownGoodStackSize                    ## CONSUMES
