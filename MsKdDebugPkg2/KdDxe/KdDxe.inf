[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = KdDxe
  FILE_GUID                      = 8D6B7D8D-518A-4E38-BD62-D5B460A68A9A
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = KdDxeInitialize

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  KdDxe.c
  Symbols.c

[Sources.AARCH64]
  AARCH64/Exception.c
  AARCH64/dbg.masm             | MSFT
  AARCH64/dbg.S                | GCC
  AARCH64/ReadWriteStatusReg.c | MSFT
  AARCH64/ReadWriteStatusReg.S | GCC

[Sources.X64]
  X64/dbg.nasm
  X64/Exception.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsKdDebugPkg2/MsKdDebugPkg.dec
  SourceLevelDebugPkg/SourceLevelDebugPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  SourceDebugEnabledLib
  KdTransportLib
  KdProtocolLib
  DevicePathLib
  WatchdogTimerLib

[Protocols]
  gEfiCpuArchProtocolGuid
  gKdDebugPrintGuid
  gEfiFirmwareVolume2ProtocolGuid

[Guids]
  gEfiEventExitBootServicesGuid

[Depex]
  gEfiCpuArchProtocolGuid
