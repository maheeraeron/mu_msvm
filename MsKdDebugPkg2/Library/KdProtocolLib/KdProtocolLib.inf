[Defines]
    INF_VERSION                    = 0x00010005
    BASE_NAME                      = KdProtocolLib
    FILE_GUID                      = EC2A785A-5D44-4602-AC9E-B379AB02ADE1
    MODULE_TYPE                    = DXE_DRIVER
    VERSION_STRING                 = 1.0
    LIBRARY_CLASS                  = KdProtocolLib

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  MsKdDebugPkg2/MsKdDebugPkg.dec

[Packages.AARCH64]
  ArmPkg/ArmPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  UefiLib
  UefiRuntimeServicesTableLib
  UefiBootServicesTableLib
  MemoryAllocationLib
  KdTransportLib
  PrintLib

[LibraryClasses.AARCH64]
  ArmLib
  CacheMaintenanceLib

[Sources]
  Break.c
  KdProtocolLib.c
  Manipulate.c
  Move.c
  Print.c

[Sources.AARCH64]
  AARCH64/Cpuapi.c
  AARCH64/Stub.c
  AARCH64/Context.c

[Sources.X64]
  X64/Cpuapi.c
  X64/Check.c
  X64/Context.c

[Guids]

[Protocols]

[Pcd]
